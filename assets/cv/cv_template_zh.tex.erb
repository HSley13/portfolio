\usepackage{xcolor}

%% ─── FONT (PingFang TC — macOS system font with full CJK support) ────────────
\IfFontExistsTF{PingFang TC}{%
  \setmainfont{PingFang TC}%
}{%
  \IfFontExistsTF{Heiti TC}{%
    \setmainfont{Heiti TC}%
  }{%
    \setmainfont{Arial Unicode MS}%
  }%
}

%% ─── COLOURS ─────────────────────────────────────────────────────────────────
\definecolor{namecolor}{HTML}{0F172A}
\definecolor{accent}{HTML}{1D4ED8}
\definecolor{subtle}{HTML}{64748B}

%% ─── PAGE GEOMETRY ───────────────────────────────────────────────────────────
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\pagestyle{empty}

%% ─── SECTION HEADING ─────────────────────────────────────────────────────────
\newcommand{\cvsection}[1]{%
  \vspace{0.7ex plus 0.2ex}%
  {\small\bfseries\color{accent}{#1}}%
  \vspace{-0.5ex}%
  \par\noindent{\color{accent}\hrule height 0.5pt}%
  \vspace{0.3ex}%
}

%% ─── COMPACT LIST ────────────────────────────────────────────────────────────
\setlength{\leftmargini}{1.5em}
\let\origitemize\itemize
\renewcommand{\itemize}{%
  \origitemize
  \setlength{\itemsep}{0pt}%
  \setlength{\topsep}{1pt}%
  \setlength{\parsep}{0pt}%
  \setlength{\partopsep}{0pt}%
}

\begin{document}

